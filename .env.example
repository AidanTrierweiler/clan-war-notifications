# =============================================
# Clash of Clans War Notification System
# Copy this file to .env and fill in your values
# =============================================

# Your clan tag (the # is optional)
CLAN_TAG=#ABC123XYZ

# Clash of Clans API token
# Get one free at: https://developer.clashofclans.com
# 1. Create an account, then create a "New Key"
# 2. Add your public IP address to the key's allowed IPs
# 3. Paste the token below
CLASH_API_TOKEN=eyJ...your_token_here

# Gmail address to send notifications FROM
# This account sends the SMS emails - it does NOT need to be your personal email
GMAIL_USER=yourname@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# How to create one:
# 1. Go to your Google Account -> Security
# 2. Enable 2-Step Verification (required)
# 3. Go to Security -> App Passwords
# 4. Select "Mail" and your device, click Generate
# 5. Paste the 16-character password below (spaces don't matter)
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Phone numbers to receive SMS, format: number:carrier
# Multiple recipients: separate with commas (no spaces)
# Example: 5551234567:verizon,5559876543:att
#
# Supported carriers:
#   att         -> AT&T
#   verizon     -> Verizon
#   tmobile     -> T-Mobile
#   sprint      -> Sprint
#   uscellular  -> US Cellular
#   boost       -> Boost Mobile
#   cricket     -> Cricket Wireless
#   metro       -> Metro by T-Mobile
#   tracfone    -> TracFone
SMS_RECIPIENTS=5551234567:verizon

# How often to check for war updates, in milliseconds
# Default: 120000 (2 minutes) - good balance of speed vs. API rate limits
# Minimum recommended: 60000 (1 minute)
POLL_INTERVAL_MS=120000
